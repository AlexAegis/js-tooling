{
	"$schema": "https://json.schemastore.org/tsconfig?mark=managed-by-autotool",
	"extends": ["$app/tsconfig", "@alexaegis/ts/svelte"],
	"compilerOptions": {
		"rootDir": "../../",
		"outDir": ".cache/tsc",
		// Set here because @alexaegis/ts/svelte replaces the types of $app/tsconfig
		"types": ["$app/types", "svelte", "node"]
	},
	"files": ["package.json", "../../package.json"],
	"include": [
		".svelte-kit/types/**/$types.d.ts",
		"src/**/*",
		"src/**/*.svelte",
		"static/**/*",
		"__mocks__/**/*",
		"*",
		".*",
		"*.json",
		".*.json",
		"**/*.json"
	],
	"exclude": [
		// A service worker needs its own tsconfig that extends $app/tsconfig/service-worker
		"src/service-worker",
		"src/service-worker.js",
		"src/service-worker.ts",
		"src/service-worker.d.ts",
		"node_modules",
		"dist",
		"coverage",
		"typedoc",
		".turbo",
		".cache",
		"vite*.config.ts.timestamp-*",
		"eslint.config.*"
	]
}
